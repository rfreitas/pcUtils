<Window x:Class="LgtvBrightness.Forms.BrightnessOsdWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Width="220" Height="64">
    <Border CornerRadius="14" Background="#DD1E1E1E" Padding="18,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                       Foreground="#EEEEEE" VerticalAlignment="Center"/>
            <StackPanel x:Name="SegmentsPanel" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
