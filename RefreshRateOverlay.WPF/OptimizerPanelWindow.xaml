<Window x:Class="RefreshRateOverlay.WPF.OptimizerPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Width="380"
        Background="#1E1E1E"
        FontFamily="Segoe UI">

    <!-- Read-only view of the game optimizer's dry run: what it WOULD do for the
         overlay's app. See plans/2026-10-07-game-optimizer-dry-run.md. -->
    <Border BorderBrush="#555555" BorderThickness="1">
        <DockPanel Margin="12">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Game optimizer" Foreground="White" FontSize="16"/>
                    <TextBlock x:Name="ModeText" Foreground="#FFB84D" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubtitleText" Foreground="#888888" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CloseButton" Style="{StaticResource IconButton}" Foreground="#AAAAAA"
                        VerticalAlignment="Top" ToolTip="Close">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
            </Grid>

            <ScrollViewer DockPanel.Dock="Top" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SectionsPanel"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
