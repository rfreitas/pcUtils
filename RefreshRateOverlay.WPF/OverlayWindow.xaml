<Window x:Class="RefreshRateOverlay.WPF.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        FontFamily="Segoe UI">

    <Border BorderBrush="#555555" BorderThickness="1">
        <Grid Margin="14" Width="280">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Refresh Rate Overlay"
                       Foreground="White" FontSize="16"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="1" x:Name="SubtitleText"
                       Foreground="#888888" FontSize="13" Margin="0,4,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="2" x:Name="PresentationText"
                       Foreground="#888888" FontSize="12" Margin="0,6,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="3" x:Name="RecommendationText"
                       Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <ComboBox Grid.Row="4" x:Name="RateDropDown"
                      Margin="0,8,0,0" FontSize="14" Height="30"/>

            <CheckBox Grid.Row="5" x:Name="HdrCheckBox" Content="Enable HDR"
                      Foreground="White" FontSize="14" Margin="0,8,0,0"/>

            <Grid Grid.Row="6" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" x:Name="SaveCheckBox"
                          Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="DeleteProfileButton" Style="{StaticResource IconButton}"
                        Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Delete saved profile"
                        Visibility="Collapsed">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </Grid>

            <Grid Grid.Row="7" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ApplyButton" Content="Apply" Style="{StaticResource FlatButton}" IsDefault="True"/>
                <Button Grid.Column="2" x:Name="CancelButton" Content="Close" Style="{StaticResource FlatButton}" IsCancel="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
