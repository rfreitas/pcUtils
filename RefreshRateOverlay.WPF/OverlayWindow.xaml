<Window x:Class="RefreshRateOverlay.WPF.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        FontFamily="Segoe UI">

    <Border BorderBrush="#555555" BorderThickness="1">
        <Grid Margin="14" Width="280">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Refresh Rate Overlay"
                       Foreground="White" FontSize="16"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <!-- Editing target — defaults to whatever's actually focused, but
                 switchable to any other running app with a window. Exists
                 because some games (confirmed: Doom: The Dark Ages) capture
                 keyboard input exclusively while focused, blocking this app's
                 global hotkey no matter which combo is bound — the only way
                 to reach their settings is to pick them here instead. -->
            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Editing:" Foreground="#888888" FontSize="13" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="2" x:Name="AppPickerDropDown" FontSize="13" Height="26"
                          ToolTip="Pick a different running app to edit its settings — useful when a game's own input capture blocks the hotkey while it's focused."/>
            </Grid>

            <TextBlock Grid.Row="2" x:Name="PresentationText"
                       Foreground="#888888" FontSize="12" Margin="0,6,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="3" x:Name="RecommendationText"
                       Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" x:Name="RateSyncDot" Width="8" Height="8"
                         Fill="LimeGreen" VerticalAlignment="Center"
                         ToolTip="Green: matches the saved value. Red: hasn't been reconciled into storage yet — Apply will save what's shown."/>
                <ComboBox Grid.Column="2" x:Name="RateDropDown" FontSize="14" Height="30"/>
            </Grid>

            <Grid Grid.Row="5" x:Name="HdrRow" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" x:Name="HdrSyncDot" Width="8" Height="8"
                         Fill="LimeGreen" VerticalAlignment="Center"
                         ToolTip="Green: matches the saved value. Red: hasn't been reconciled into storage yet — Apply will save what's shown."/>
                <CheckBox Grid.Column="2" x:Name="HdrCheckBox" Content="Enable HDR"
                          Foreground="White" FontSize="14" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="6" x:Name="DsxProfileRow" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Controller:" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="2" x:Name="DsxProfileDropDown" FontSize="14" Height="30"/>
            </Grid>

            <Grid Grid.Row="7" x:Name="GsyncModeRow" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" x:Name="GsyncSyncDot" Width="8" Height="8"
                         Fill="LimeGreen" VerticalAlignment="Center"
                         ToolTip="Green: matches the saved value. Red: hasn't been reconciled into storage yet — Apply will save what's shown."/>
                <TextBlock Grid.Column="2" Text="G-SYNC Mode:" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="4" x:Name="GsyncModeDropDown" FontSize="14" Height="30"/>
            </Grid>

            <!-- NVIDIA's own per-app G-SYNC override for this app, distinct from
                 the G-SYNC Mode setting above (the global/base-profile toggle
                 this app controls). No default/global scope of its own to fall
                 back to, so it's only ever editable while "Save for <app>" is
                 ticked — grayed out otherwise, no sync dot (nothing reconciles
                 this in the background the way Rate/HDR/GsyncMode do). -->
            <Grid Grid.Row="8" x:Name="AppVrrRow" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="App VRR:" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="2" x:Name="AppVrrDropDown" FontSize="14" Height="30" IsEnabled="False"/>
            </Grid>

            <Grid Grid.Row="9" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" x:Name="SaveCheckBox"
                          Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="DeleteProfileButton" Style="{StaticResource IconButton}"
                        Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Delete saved profile"
                        Visibility="Collapsed">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </Grid>

            <Grid Grid.Row="10" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ApplyButton" Content="Apply" Style="{StaticResource FlatButton}" IsDefault="True"/>
                <Button Grid.Column="2" x:Name="CancelButton" Content="Close" Style="{StaticResource FlatButton}" IsCancel="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
