<Window x:Class="SteamDxvk.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam DXVK Manager"
        Width="1180" Height="860" MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D2D" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="12">

    <!-- Self-contained: theme merged here (not App.xaml) so tests can build the window without an Application. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Background on the root element, not just the Window: RenderTargetBitmap ignores Window.Background. -->
    <Grid x:Name="Root" Background="#2D2D2D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="10,10,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RescanBtn" Grid.Column="0" Content="Rescan"/>
            <Button x:Name="FetchBtn" Grid.Column="1" Content="Download latest DXVK" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="3" Text="Show" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="FilterBox" Grid.Column="4" Width="150"/>
            <TextBlock Grid.Column="5" Text="Search" Foreground="#888888" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <TextBox x:Name="SearchBox" Grid.Column="6" Width="200"/>
        </Grid>

        <ProgressBar x:Name="Progress" Grid.Row="1" Height="3" Margin="10,0,10,6" Minimum="0" Maximum="1" Value="0"/>

        <!-- Column headers (built in code, click to sort) -->
        <Grid x:Name="HeaderGrid" Grid.Row="2" Margin="10,0,20,2"/>

        <!-- Game list -->
        <Border Grid.Row="3" Margin="10,0,10,0" BorderBrush="#555555" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Rows"/>
            </ScrollViewer>
        </Border>

        <!-- Selected game -->
        <Border Grid.Row="4" Margin="10,10,10,0" BorderBrush="#555555" BorderThickness="1" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="DetailTitle" FontSize="14" FontWeight="SemiBold" Text="Select a game"/>
                <TextBlock x:Name="DetailPath" Foreground="#888888" Margin="0,2,0,10" TextTrimming="CharacterEllipsis"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Executable" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ExeBox" Grid.Column="1"/>
                </Grid>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock x:Name="RunLabel" Text="Run as" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Which renderer the game starts with. Only shown for games whose engine has launch flags (Unreal -dx11, Unity -force-d3d11, ...): the app passes the flag when you press Launch."/>
                    <ComboBox x:Name="RunBox" Width="200" Margin="0,0,20,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox x:Name="DxvkBox" Content="Use DXVK (translate to Vulkan)" VerticalAlignment="Center"
                              ToolTip="Ticking installs DXVK for this game; unticking restores the original files. The right DLLs are chosen automatically."/>
                </WrapPanel>

                <!-- DXVK options: shown while DXVK is ticked, greyed when it can't be used. Hidden (not Collapsed) when off, so the row's
                     space stays reserved and ticking DXVK doesn't push everything below it down. -->
                <WrapPanel x:Name="DxvkOptionsPanel" Margin="26,8,0,0" Visibility="Hidden">
                    <CheckBox x:Name="AsyncBox" Content="Async shader compilation (dxvk-gplasync)" VerticalAlignment="Center" Margin="0,0,20,0"
                              ToolTip="Draws frames before shaders finish compiling instead of stalling. Can cause brief missing objects, and may trip anti-cheat."/>
                    <TextBlock Text="Pipeline library" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Auto: compile optimised pipelines in the background. True: skip that. False: off (saves VRAM)."/>
                    <ComboBox x:Name="GplBox" Width="80" Margin="0,0,20,0"/>
                    <CheckBox x:Name="HudBox" Content="Compiler HUD" VerticalAlignment="Center"
                              ToolTip="Shows DXVK's shader-compiler activity on screen."/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <!-- MinWidth: the label alternates with "Launch anyway", and a width change would shift the buttons beside it. -->
                    <Button x:Name="LaunchBtn" Content="Launch via Steam" MinWidth="130" ToolTip="Checks the DXVK files and dxvk.conf are intact (repairing them if Steam reverted them), then starts the game through Steam with the Run as flag."/>
                    <Button x:Name="OpenBtn" Content="Open folder" Margin="8,0,0,0"/>
                    <Button x:Name="CheckBtn" Content="Check last run" Margin="8,0,0,0" ToolTip="Reads DXVK's log files to report which API the game really used."/>
                </StackPanel>

                <!-- Every message lives in this one fixed-height status area under the buttons, so picking an option or a game can
                     never push a control around: lines come and go inside the reserved space (it scrolls if ever more than fits). -->
                <ScrollViewer x:Name="MessageArea" Height="68" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="RunStatusText" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>
                        <TextBlock x:Name="WarningText" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Log -->
        <TextBox x:Name="LogBox" Grid.Row="5" Height="96" Margin="10,10,10,10" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Foreground="#CCCCCC" Background="#262626"/>
    </Grid>
</Window>
